{
  "expo": {
    "name": "Kosh",
    "slug": "kosh",
    "version": "1.0.0",
    "scheme": "kosh",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anchit.kosh",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Kosh uses Face ID to unlock your encrypted portfolio.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.anchit.kosh",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Kosh to access Face ID for unlocking your portfolio."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Kosh to use Face ID to unlock your portfolio."
        }
      ],
      "expo-document-picker"
    ]
  }
}
